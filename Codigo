# Variável para definir o número de entrevistados (10 para o teste, 50 na versão final)
TOTAL_ENTREVISTADOS = 10

# Variáveis contadoras
qtd_excelente = 0
qtd_ruim = 0

print("=" * 40)
print("   PESQUISA DE SATISFAÇÃO - TUDOWEB   ")
print("=" * 40)

# Estrutura de repetição para coletar os dados de cada entrevistado
for i in range(TOTAL_ENTREVISTADOS):
    print(f"\n--- Entrevistado {i + 1} de {TOTAL_ENTREVISTADOS} ---")
    
    # Coleta de dados
    nome = input("Nome: ")
    idade = int(input("Idade: "))
    
    print("\nComo você avalia nosso atendimento?")
    print("1: EXCELENTE")
    print("2: BOM")
    print("3: RUIM")
    
    opiniao = int(input("Digite sua opinião (1, 2 ou 3): "))
    
    # Estrutura de decisão para verificar e contabilizar a opinião
    if opiniao == 1:
        qtd_excelente += 1
